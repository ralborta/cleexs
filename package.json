{
  "name": "cleexs",
  "version": "1.0.0",
  "private": true,
  "description": "PRIA - AI Recommendation Index Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:provision:account": "tsx prisma/provision-account.ts",
    "db:list-recent-runs": "tsx prisma/list-recent-runs-portal-users.ts",
    "db:random-portal-from-runs": "tsx prisma/random-portal-user-from-recent-runs.ts",
    "db:portal-user-brand": "tsx prisma/portal-user-for-brand.ts",
    "db:set-portal-password": "tsx prisma/set-portal-password.ts",
    "portal:env": "tsx prisma/print-portal-env.ts",
    "deploy:api": "prisma migrate deploy && node apps/api/dist/index.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.7.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "prisma": "^5.7.0",
    "tsx": "^4.7.0",
    "turbo": "^1.11.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
