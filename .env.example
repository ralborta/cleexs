# Database
DATABASE_URL="postgresql://user:password@localhost:5432/cleexs?schema=public"

# NextAuth / Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# API
API_URL="http://localhost:3001"
API_PORT=3001

# Logos de marcas (capa 1 — ambos proveedores activos)
# Brandfetch (wordmark) + Logo.dev (fallback verificado). Gratis:
#   Brandfetch: https://developers.brandfetch.com/register
#   Logo.dev:   https://www.logo.dev (Publishable key)
NEXT_PUBLIC_BRANDFETCH_CLIENT_ID=""
NEXT_PUBLIC_LOGO_DEV_TOKEN=""
# En Railway API (mismo valor):
# BRANDFETCH_CLIENT_ID=""
# LOGO_DEV_TOKEN=""

# Cloudflare Turnstile (captcha) - deshabilitado por ahora (URLs dinámicas de Vercel cambian en cada deploy)
# Si querés reactivarlo con dominio estable: NEXT_PUBLIC_TURNSTILE_SITE_KEY + TURNSTILE_SECRET_KEY

# Redis (para BullMQ)
REDIS_URL="redis://localhost:6379"

# OpenAI (Freemium + Gold: análisis del diagnóstico)
# En prod: Railway → API → Variables
OPENAI_API_KEY=""

# Gemini (Gold: análisis adicional con Google AI)
# En prod: Railway → API → Variables. Si falta, Gold usa solo OpenAI.
GOOGLE_AI_API_KEY=""
# Alternativa: GEMINI_API_KEY=""

# Email (diagnóstico público, envío directo)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@cleexs.com"
# Alternativas: SMTP_FROM_EMAIL (remitente), SMTP_FROM_NAME (nombre del remitente)
# FRONTEND_URL: URL del front (app) para links en emails y CORS. En prod: https://app.cleexs.net
FRONTEND_URL="http://localhost:3000"

# Next.js (apps/web): URL canónica del producto en producción (Vercel). Local: http://localhost:3000
# NEXT_PUBLIC_APP_URL="https://app.cleexs.net"

# Mercado Pago (sandbox/prod según credenciales cargadas en el entorno; no commitear valores reales)
MP_ACCESS_TOKEN=""
MP_PUBLIC_KEY=""
MP_WEBHOOK_SECRET=""
MP_NOTIFICATION_URL="https://api.tudominio.com/api/webhooks/mercadopago"

# Billing
BILLING_CURRENCY="ARS"
BILLING_USD_TO_ARS_RATE="1400"

# Sentry (opcional)
SENTRY_DSN=""
