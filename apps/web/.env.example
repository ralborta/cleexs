# URL del backend (local o producción)
# NEXT_PUBLIC_API_URL=http://localhost:3001

# Portal cliente (/portal-crecimiento): UUID reales de tu base (tenant + usuario)
# NEXT_PUBLIC_PORTAL_TENANT_ID=
# NEXT_PUBLIC_PORTAL_USER_ID=
# Opcional: marca para “Generar reporte profundo” (POST /api/reports/:brandId/deep-generate)
# NEXT_PUBLIC_PORTAL_BRAND_ID=

# Opcional: textos del encabezado del portal
# NEXT_PUBLIC_PORTAL_TITLE=
# NEXT_PUBLIC_PORTAL_SUBTITLE=
