# URL del backend (local o producción). En Railway: URL pública HTTPS del servicio API.
# NEXT_PUBLIC_API_URL=http://localhost:3001

# App producto (diagnóstico, portal). Producción: https://app.cleexs.net
# NEXT_PUBLIC_APP_URL=https://app.cleexs.net
# Número wa.me / QR auspiciadores (default: bot Baileys Cleexs)
# NEXT_PUBLIC_CLEEXS_WHATSAPP_PHONE=5491162630542

# Base de links de auspiciador / QR. Por defecto app.cleexs.net (diagnóstico). Solo usar cleexs.net con redirect 301 en Hostinger.
# NEXT_PUBLIC_SPONSOR_LINK_BASE_URL=https://app.cleexs.net

# Portal: sesión por email/contraseña (token en sessionStorage).

# Opcional: textos del encabezado del portal
# NEXT_PUBLIC_PORTAL_TITLE=
# NEXT_PUBLIC_PORTAL_SUBTITLE=
# Subtítulo morado del panel (diferente al texto del login si hace falta):
# NEXT_PUBLIC_PORTAL_PANEL_SUBTITLE=

# Admin web (/admin/login → /admin/cuentas): credenciales de la UI (no es el secret de la API).
# ADMIN_UI_USERNAME=admin
# ADMIN_UI_PASSWORD=
# Por defecto el login es obligatorio. Solo para demo: ADMIN_OPEN_ACCESS=true
# ADMIN_OPEN_ACCESS=false
# Opt-out explícito del login: ADMIN_REQUIRE_AUTH=false
# Opcional: firma de cookie (si no va, se usa ADMIN_UI_PASSWORD)
# ADMIN_UI_SESSION_SECRET=

# Mismo valor que en el servicio API (solo servidor Next, nunca NEXT_PUBLIC_*).
# ADMIN_API_SECRET=

# URL de la API para que las rutas /api/admin-ui/* hagan proxy (si no, se usa NEXT_PUBLIC_API_URL).
# API_URL=

# URL pública opcional: análisis técnico ampliado del sitio (AEO), si tu organización lo expone en un front propio.
# NEXT_PUBLIC_CLEEXS_TOOLS_URL=https://…

# Video de Gonzalo en onboarding (cafecito). URL completa o solo el ID de YouTube.
# NEXT_PUBLIC_ONBOARDING_YOUTUBE_URL=https://www.youtube.com/watch?v=o9cgoy7MaxA

# Número WhatsApp del QR de auspiciadores: actualmente se define fijo en código.
