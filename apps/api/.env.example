# URL base del servicio Cleexs Tools / satélite (sin barra final)
SATELLITE_BASE_URL=https://tu-satelite.up.railway.app

# Tiempo máximo de espera del cliente API al POST /api/analyze-all (ms).
# Debe ser >= al timeout del propio satélite; por defecto 130000 (130s).
SATELLITE_TIMEOUT_MS=130000

# false para desactivar el módulo satélite en diagnósticos públicos
# SATELLITE_ENABLED=true
