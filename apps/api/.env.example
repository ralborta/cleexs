# App Next (enlaces en correos: ver-resultado, compartir). Producción: https://app.cleexs.net
# CLEEXS_APP_URL=https://app.cleexs.net

# Canal WhatsApp TV
# Flow URL BuilderBot (plugin HTTP POST):
#   URL: {API_URL}/api/public/diagnostic/whatsapp/url
#   Body JSON: { "from": "{{from}}", "message": "{{body}}" }
#   (from = teléfono para responder; message = último mensaje con la URL)
# BUILDERBOT_BOT_ID=uuid-bot-cleexs
# BUILDERBOT_API_KEY=envía-score-al-terminar
# Bot Baileys self-hosted (EasyPanel Agente_Cleexs). Prioridad sobre BBC si está definido.
# BAILEYS_BOT_URL=https://wa-bot.cleexs.net
# URL pública para pasar al cliente (QR). Si no está, se usa BAILEYS_BOT_URL si es https.
# BAILEYS_BOT_PUBLIC_URL=https://wa-bot.cleexs.net
# WHATSAPP_CHANNEL_API_KEY=header-x-cleexs-channel-key-del-plugin-http
# WA_CHANNEL_DAILY_LIMIT=5
# WA_CHANNEL_COMPETITOR_WAIT_MS=90000

# URL base del servicio de análisis técnico del sitio (satélite / AEO), sin barra final
SATELLITE_BASE_URL=https://tu-satelite.up.railway.app

# Logos (capa 1 brand-assets): Brandfetch Client ID (mismo que NEXT_PUBLIC_ en Vercel)
# BRANDFETCH_CLIENT_ID=
# LOGO_DEV_TOKEN=

# Tiempo máximo de espera al resultado (polling + job). El análisis completo puede tardar minutos.
# Por defecto 600000 (10 min). El satélite usa /analyze-all/start + GET /jobs para evitar cortes del proxy.
# Mínimo recomendado ~10–15 min (análisis completo + IAs). Valores bajos → timeout con score 0.
SATELLITE_TIMEOUT_MS=900000

# false para desactivar el módulo satélite en diagnósticos públicos
# SATELLITE_ENABLED=true

# Opcional: tope de caracteres JSON por herramienta al guardar detalle satélite (default 110000, máx 220000).
# SATELLITE_TOOL_DETAIL_STORE_MAX_CHARS=110000

# Visitas únicas distintas (UUID en el navegador) para desbloquear el reporte completo en /score/{slug}. Por defecto 5.
# PUBLIC_SHARE_VIRAL_UNLOCK_MIN=5

# Firecrawl (v2): outreach por dominio y, en diagnóstico público, texto del sitio para vertical + competidores.
# También fallback en auditoría agéntica cuando el WAF del sitio bloquea fetch directo.
# FIRECRAWL_API_KEY=

# PageSpeed Insights API key (auditoría agéntica — cuota sin 429). Google Cloud → PageSpeed Insights API.
# PAGESPEED_API_KEY=

# Máximo de páginas a scrapear por URL en el diagnóstico público (home + rutas típicas). Por defecto 3.
# PUBLIC_DIAGNOSTIC_FIRECRAWL_MAX_PAGES=3

# Admin: overrides + provision + búsqueda usuarios. Header x-admin-secret en POST/GET /api/admin/*
# POST /api/admin/provision-account · GET /api/admin/users?q=
# POST /api/admin/portal-user-for-brand  body: { "brandName": "Hinds", "password": "Cleexs123" }  (email opcional)
# ADMIN_API_SECRET=

# Emails con bypass total de permisos (coma-separados). Solo personal interno.
# ADMIN_FULL_ACCESS_EMAILS=admin@cleexs.com

# Portal (/portal-crecimiento): JWT para sesión tras POST /api/auth/portal/login (mín. 32 caracteres aleatorios).
# PORTAL_JWT_SECRET=

# Solo desarrollo: permitir tenantId/userId en query en /api/me/usage, /api/brands, reportes (sin Bearer).
# ALLOW_USAGE_ACTOR_QUERY=false

# SMTP saliente (diagnóstico, secuencia free, marketing). Usar dominio cleexs.net verificado en Resend.
# @nivel41.com se ignora en código y se reemplaza por hola@cleexs.net.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_xxxxx
# SMTP_FROM_EMAIL=hola@cleexs.net
# SMTP_FROM_NAME=Cleexs

# Resend REST (admin send-test y futuros envíos por API). Opcional si ya usás SMTP Resend.
# RESEND_API_KEY=re_xxxxx

# Hero del email mensual de Cleexs Score (URL absoluta, ej. https://app.cleexs.net/email/monthly-score-hero.png)
# MONTHLY_SCORE_EMAIL_HERO_URL=
# MONTHLY_SCORE_EMAIL_FOUNDER_PHOTO_URL=
# MONTHLY_SCORE_EMAIL_VARIANT=letter
# MONTHLY_SCORE_EMAIL_DAY_UTC=1
# MONTHLY_SCORE_EMAIL_HOUR_UTC=14

# Cold outreach a competidores. Usar @cleexs.net (nivel41 queda bloqueado en código).
# OUTREACH_FROM_EMAIL=outreach@cleexs.net
# OUTREACH_FROM_NAME=Gonzalo de Cleexs
# OUTREACH_REPLY_TO=info@cleexsnet.com
# OUTREACH_SHADOW_TO=ralborta@cleexs.com
# OUTREACH_DOMAIN_VERIFIED=false
# OUTREACH_DAILY_LIMIT=20

# Signing secret del webhook Resend (Svix). Sin esto la API responde 503 y no se guardan eventos → métricas en 0.
# En Resend → Webhooks: URL = {PUBLIC_WEBHOOK_BASE_URL o API_URL}/api/webhooks/resend
# RESEND_WEBHOOK_SECRET=whsec_xxxxx

# Opcional: dominio público solo para mostrar/armar la URL del webhook (si difiere de API_URL)
# PUBLIC_WEBHOOK_BASE_URL=https://cleexsapi-production.up.railway.app

# Desactivar todo envío de correo en esta API
# DISABLE_EMAILS=true
